{
  "name": "drip-css",
  "version": "1.0.0",
  "description": "Una biblioteca de estilos CSS moderna y minimalista tipo Bootstrap con enfoque urbano",
  "main": "dist/drip-css.min.css",
  "files": [
    "dist/",
    "src/",
    "docs/",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "sass src/scss/main.scss dist/drip-css.css --style=expanded",
    "build:min": "sass src/scss/main.scss dist/drip-css.min.css --style=compressed",
    "build:js": "webpack --mode=production",
    "dev": "npm run dev:css & npm run dev:js & npm run serve",
    "dev:css": "sass --watch src/scss/main.scss:dist/drip-css.css --style=expanded",
    "dev:js": "webpack --mode=development --watch",
    "serve": "live-server --port=3000 --open=/docs/",
    "lint:css": "stylelint src/scss/**/*.scss",
    "format": "prettier --write src/**/*.{scss,js,html}",
    "test": "echo \"Tests not implemented yet\" && exit 0"
  },
  "keywords": [
    "css",
    "framework",
    "bootstrap",
    "urban",
    "minimalist",
    "components",
    "responsive",
    "drip"
  ],
  "author": "Angel Osmin Ramirez Berrios, Diego José Morataya Chávez, Kevin Israel Rodriguez Rivera, Rafael Humberto Lino Lovo",
  "license": "MIT",
  "homepage": "https://0kev0.github.io/",
  "repository": {
    "type": "git",
    "url": "https://github.com/0kev0/0Kev0.github.io.git"
  },
  "bugs": {
    "url": "https://github.com/0kev0/0Kev0.github.io/issues"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "autoprefixer": "^10.4.16",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "cssnano": "^6.0.1",
    "live-server": "^1.2.2",
    "mini-css-extract-plugin": "^2.7.6",
    "postcss": "^8.4.31",
    "postcss-loader": "^7.3.3",
    "prettier": "^3.0.3",
    "sass": "^1.69.5",
    "sass-loader": "^13.3.2",
    "stylelint": "^15.11.0",
    "stylelint-config-standard-scss": "^11.0.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
